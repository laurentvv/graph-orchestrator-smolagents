   1| // Helper pour le délai d'animation
   2| function sleep(ms) {
   3|     return new Promise(resolve => setTimeout(resolve, ms));
   4| }
   5| 
   6| // État global
   7| let arr = [];
   8| let bars = [];
   9| let isSorting = false;
  10| let comparisonCount = 0;
  11| let speed = 50; // ms par étape
  12| 
  13| // Éléments DOM
  14| const chartEl = document.getElementById('chart');
  15| const startBtn = document.getElementById('startBtn');
  16| const resetBtn = document.getElementById('resetBtn');
  17| const speedRange = document.getElementById('speedRange');
  18| const counterEl = document.getElementById('counter');
  19| 
  20| // Générer un tableau aléatoire
  21| function generateArray(size = 30) {
  22|     arr = Array.from({ length: size }, () => Math.floor(Math.random() * 
100) + 1);
  23|     return arr;
  24| }
  25| 
  26| // Dessiner les barres
  27| function draw() {
  28|     chartEl.innerHTML = '';
  29|     bars = [];
  30|     const maxVal = Math.max(...arr);
  31|     
  32|     arr.forEach((value, index) => {
  33|         const bar = document.createElement('div');
  34|         bar.className = 'bar';
  35|         bar.style.height = (value / maxVal) * 250 + 'px';
  36|         chartEl.appendChild(bar);
  37|         bars.push(bar);
  38|     });
  39| }
  40| 
  41| // Mettre à jour la hauteur d'une barre
  42| function updateBar(index) {
  43|     if (bars[index]) {
  44|         bars[index].style.height = (arr[index] / Math.max(...arr)) * 250 
+ 'px';
  45|     }
  46| }
  47| 
  48| // Swap de deux éléments dans le tableau et le DOM
  49| function swap(i, j) {
  50|     [arr[i], arr[j]] = [arr[j], arr[i]];
  51|     updateBar(i);
  52|     updateBar(j);
  53| }
  54| 
  55| // Algorithme Bubble Sort avec animation pas-à-pas
  56| async function bubbleSort() {
  57|     if (isSorting) return;
  58|     isSorting = true;
  59|     startBtn.disabled = true;
  60|     
  61|     comparisonCount = 0;
  62|     counterEl.textContent = '0';
  63|     
  64|     let swapped = true;
  65|     while (swapped) {
  66|         swapped = false;
  67|         for (let i = 0; i < arr.length - 1; i++) {
  68|             // Marquer les barres en cours de comparaison
  69|             bars[i].classList.add('comparing');
  70|             bars[i + 1].classList.add('comparing');
  71|             
  72|             // Attendre le délai
  73|             await sleep(speed);
  74|             
  75|             // Comparaison
  76|             if (arr[i] > arr[i + 1]) {
  77|                 comparisonCount++;
  78|                 counterEl.textContent = comparisonCount.toString();
  79|                 
  80|                 // Swap
  81|                 swapped = true;
  82|                 swap(i, i + 1);
  83|             }
  84|             
  85|             // Retirer le marquage de comparaison
  86|             bars[i].classList.remove('comparing');
  87|             bars[i + 1].classList.remove('comparing');
  88|         }
  89|     }
  90|     
  91|     // Marquer toutes les barres comme triées
  92|     bars.forEach(bar => bar.classList.add('sorted'));
  93|     
  94|     isSorting = false;
  95|     startBtn.disabled = false;
  96| }
  97| 
