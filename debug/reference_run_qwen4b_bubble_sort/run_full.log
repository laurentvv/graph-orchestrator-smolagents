  78|                 // Sync DOM after swap
  79|                 updateBar(i);
  80|                 updateBar(i + 1);
  81|                 
  82|                 // Mark swapped bars as sorted
  83|                 bars[i].classList.add('sorted');
  84|                 bars[i + 1].classList.add('sorted');
  85|             }
  86|         }
  87|         // Remove comparing class
