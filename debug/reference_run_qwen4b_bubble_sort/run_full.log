  67|                 // Mark as comparing
  68|                 bars[i].classList.add('comparing');
  69|                 bars[i + 1].classList.add('comparing');
  70|                 
  71|                 // Wait for speed
  72|                 await sleep(speed);
  73|                 
  74|                 // Swap values
