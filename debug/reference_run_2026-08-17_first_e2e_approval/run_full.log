   1| // Sleep helper for async animation
   2| function sleep(ms) {
   3|     return new Promise(resolve => setTimeout(resolve, ms));
   4| }
   5| 
   6| // DOM Elements
   7| const startBtn = document.getElementById('start-btn');
   8| const resetBtn = document.getElementById('reset-btn');
   9| const speedSlider = document.getElementById('speed-slider');
  10| const speedValue = document.getElementById('speed-value');
  11| const comparisonCounter = document.getElementById('comparison-counter');
  12| const barsContainer = document.getElementById('bars-container');
  13| 
  14| // State
  15| let arr = [];
  16| let isSorting = false;
  17| let comparisons = 0;
  18| let bars = [];
  19| 
  20| // Generate random array (1-100)
  21| function generateArray(size = 50) {
  22|     arr = Array.from({ length: size }, () => Math.floor(Math.random() * 
100) + 1);
  23|     return arr;
  24| }
  25| 
  26| // Draw bars
  27| function draw() {
  28|     barsContainer.innerHTML = '';
  29|     const maxVal = Math.max(...arr);
  30|     
  31|     arr.forEach((value, index) => {
  32|         const bar = document.createElement('div');
  33|         bar.className = 'bar';
  34|         bar.style.height = `${(value / maxVal) * 250}px`;
  35|         barsContainer.appendChild(bar);
  36|         bars[index] = bar;
  37|     });
  38| }
  39| 
  40| // Update bar height
  41| function updateBar(index, maxVal) {
  42|     if (bars[index]) {
  43|         bars[index].style.height = `${(arr[index] / maxVal) * 250}px`;
  44|     }
  45| }
  46| 
  47| // Bubble Sort with animation
  48| async function bubbleSort() {
  49|     if (isSorting) return;
  50|     isSorting = true;
  51|     startBtn.disabled = true;
  52|     comparisons = 0;
  53|     comparisonCounter.textContent = `Comparaisons : ${comparisons}`;
  54|     
  55|     const maxVal = Math.max(...arr);
  56|     let swapped = true;
  57|     
  58|     while (swapped) {
  59|         swapped = false;
  60|         for (let i = 0; i < arr.length - 1; i++) {
  61|             // Mark bars as comparing
  62|             bars[i].classList.add('comparing');
  63|             bars[i + 1].classList.add('comparing');
  64|             
  65|             // Wait for animation speed
  66|             await sleep(speedSlider.value);
  67|             
  68|             // Compare
  69|             if (arr[i] > arr[i + 1]) {
  70|                 // Swap values
  71|                 [arr[i], arr[i + 1]] = [arr[i + 1], arr[i]];
  72|                 comparisons++;
  73|                 comparisonCounter.textContent = `Comparaisons : 
${comparisons}`;
  74|                 swapped = true;
  75|                 
  76|                 // Sync DOM after swap
  77|                 updateBar(i, maxVal);
  78|                 updateBar(i + 1, maxVal);
  79|             }
  80|             
  81|             // Remove comparing class
  82|             bars[i].classList.remove('comparing');
  83|             bars[i + 1].classList.remove('comparing');
  84|         }
  85|     }
  86|     
  87|     // Mark all as sorted
  88|     bars.forEach(bar => bar.classList.add('sorted'));
  89|     
  90|     isSorting = false;
  91|     startBtn.disabled = false;
  92| }
  93| 
  94| // Reset
  95| function reset() {
  96|     isSorting = false;
  97|     startBtn.disabled = false;
  98|     comparisons = 0;
  99|     comparisonCounter.textContent = `Comparaisons : ${comparisons}`;
 100|     generateArray();
 101|     draw();
 102| }
 103| 
 104| // Event Listeners
 105| startBtn.addEventListener('click', bubbleSort);
 106| resetBtn.addEventListener('click', reset);
 107| speedSlider.addEventListener('input', (e) => {
 108|     speedValue.textContent = e.target.value;
 109| });
 110| 
 111| // Initialize
 112| generateArray();
 113| draw();


