# Corriger le bug du compteur dans script.js                                   
# Ajouter l'incrément et la mise à jour du DOM après chaque comparaison        
fix = search_replace(path="script.js", old_string=r"""            // Compare   
            if (arr[i] > arr[i + 1]) {                                         
                // Swap values                                                 
                [arr[i], arr[i + 1]] = [arr[i + 1], arr[i]];                   
                swapped = true;                                                
                                                                               
                // Sync DOM after swap                                         
                updateBar(i, maxVal);                                          
                updateBar(i + 1, maxVal);                                      
            }""", new_string=r"""            // Compare                        
            if (arr[i] > arr[i + 1]) {                                         
                // Swap values                                                 
                [arr[i], arr[i + 1]] = [arr[i + 1], arr[i]];                   
                comparisons++;                                                 
                comparisonCounter.textContent = `Comparaisons :                
${comparisons}`;                                                               
                swapped = true;                                                
                                                                               
                // Sync DOM after swap                                         
                updateBar(i, maxVal);                                          
                updateBar(i + 1, maxVal);                                      
            }""")                                                              
print(fix)                                                                     
```                                                                            
                                                                               
