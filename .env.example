# ============================================================
# Configuration du Graph Orchestrator
# Copiez ce fichier en .env et adaptez les valeurs.
# Toutes les variables sont optionnelles (des défauts s'appliquent).
# ============================================================

# --- Connexion Ollama (endpoint OpenAI-compatible) ---
OLLAMA_API_BASE=http://localhost:11434/v1
# Endpoint dédié au modèle de RAISONNEMENT (Architect/Judge/PromptRefiner). Par défaut,
# retombe sur OLLAMA_API_BASE. Utile quand le FAST (Coder) est sur un serveur distant CPU
# (ex: 10.201.12.50) mais que le RAISONNEMENT (gemma) reste sur localhost GPU pour la latence.
OLLAMA_REASONING_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=sk-local
# Timeout (secondes) d'un appel LLM. Au-delà, l'appel échoue (et peut être retryé par
# smolagents). Sans timeout, un endpoint distant muet fige le workflow indéfiniment.
# 600s = généreux pour un Coder qui produit un gros fichier en CPU-only distant.
LLM_TIMEOUT_S=600

# --- Tiering des modèles ---
# Fan-out (workers) : modèle léger avec tool-calling natif.
FAST_MODEL_ID=qwen3.5:2b
# Juge + Synthèse : modèle de raisonnement costaud.
REASONING_MODEL_ID=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# IMPORTANT : max_tokens généreux obligatoire pour Gemma. Sans ça, Ollama
# renvoie finish_reason=length sans tool_calls (le raisonnement interne consomme tout).
REASONING_MAX_TOKENS=8192
# Budget de génération du modèle FAST (Coder). Un fichier HTML/CSS/JS complet
# dépasse 2000-4000 tokens ; trop bas = génération coupée en plein tool_call JSON
# = contenu corrompu. 12000 laisse de la marge (inclut le "thinking" du Qwen3.5).
FAST_MAX_TOKENS=12000
# Température du Coder (CRITIQUE pour le code). Le défaut serveur qwen3.5:4b est
# 1.0 (chat créatif) → corruption aléatoire de la syntaxe. 0.2 = déterministe.
CODER_TEMPERATURE=0.2

# --- Règles métier ---
# Seuil de confiance du Juge (un worker avec confidence_score < seuil est rejeté).
JUDGE_CONFIDENCE_THRESHOLD=0.7
# Nombre de tentatives de parsing JSON avant échec définitif.
WORKER_MAX_RETRIES=3

# --- Vérification adversaire (§5 du guide) ---
# Nombre de sceptiques indépendants qui tentent de réfuter chaque résultat.
# Ils tournent en parallèle et partagent le même modèle (économique).
ADVERSARY_COUNT=3
# Fraction de sceptiques requise pour réfuter une tâche (>= 0.5 = majorité).
ADVERSARY_THRESHOLD=0.5

# --- Cycles de convergence (§5, mode exploration) ---
# Hard cap d'itérations : le loop-until-dry s'arrête de force au-delà (anti-boucle-infinie).
MAX_ITERATIONS=3

# --- Human-in-the-loop (§5) ---
# Si true, un prompt bloquant (y/n) demande validation avant la synthèse.
HITL_ENABLED=false
# Nœuds déclenchant le HITL (CSV) — routage stratégique. Seuls ces nœuds
# paused pour approbation humaine (ex: "synth" ou "synth,transaction").
HITL_NODES=synth

# --- Knowledge Graph persistant (Phase 5) ---
# Chemin du fichier DuckDB. ":memory:" = graphe volatil (perdu à la fin du process).
KG_PATH=graph_orchestrator.db

# --- Mode de workflow ---
# "one_shot" : Fan-out -> Reduce -> Adversaire -> Synth (défaut, agent_graph.py)
# "exploration" : loop-until-dry sur des tâches d'exploration (python -m graph_orchestrator.workflows)
WORKFLOW_MODE=one_shot

# --- Observabilité / logs ---
# Verbosité des workers en parallèle : LOW (recommandé), MEDIUM, HIGH.
# Le Juge et la Synthèse restent toujours en HIGH (ils sont séquentiels).
LOG_LEVEL=LOW
CONTEXT7_API_KEY=your-api-key-here

# --- Reprise après crash (Priorité 3 : Checkpoints) ---
# Si "1"/"true", ignore tout checkpoint existant et démarre une exécution fraîche
# (même si le contenu de la tâche correspond à un run interrompu). Utile pour
# relancer une génération de zéro après avoir modifié le prompt dans tasks.json.
FRESH_START=false

# --- Boucle d'auto-correction (Priorité 2 : capture/troncature stderr) ---
# Sans plafond, un gros traceback (500+ lignes) avalé à chaque itération fait
# exploser le contexte du LLM ("Context Overflow") → la boucle diverge.
# Le Tester polyvalent capture stdout/stderr (web: console JS, python: pytest)
# et tronque (head+tail) avant de l'injecter au Coder. Voir feedback_utils.py.

# Timeout (s) d'un runner de tests en subprocess (pytest, etc.). Au-delà,
# le runner abandonne proprement (un test qui boucle ne fige pas l'usine).
TEST_TIMEOUT_S=120
# Lignes de tête (l'erreur, en haut) et de queue (la cause racine, en bas)
# conservées lors de la troncature. Le milieu bruyant est remplacé par un marqueur.
STDERR_HEAD_LINES=20
STDERR_TAIL_LINES=20
# Plafond global (caractères) du feedback injecté au Coder. L'historique cumulé
# des réfutations (bugs) est borné à cette taille ; les bugs récents sont prioritaires.
FEEDBACK_MAX_CHARS=2000

# --- Nœud d'Escalade (Priorité 3 : post-mortem sur circuit breaker) ---
# Si "true" (défaut), quand une sous-tâche épuise le Circuit Breaker (3 itérations
# toutes rejetées), un nœud DSPy synthétise les réfutations accumulées en un
# diagnostic post-mortem (cause racine + leçon), le persiste dans le Knowledge
# Graph (kind="escalation") et marque la sous-tâche "escalated". Si "false", on
# retombe sur le comportement historique (statut brut "max_iterations_reached").
ESCALATION_ENABLED=true

# --- Auto-Résolution des Dépendances (Priorité 5 : Tester Python) ---
# Si "true" (défaut), quand le PythonTestRunner détecte un `ModuleNotFoundError`
# dans le stderr, il installe lui-même le package manquant (`pip install`,
# non-persistant — n'écrit PAS dans pyproject.toml/uv.lock) puis relance les tests,
# au lieu de gaspiller un cycle LLM pour ça. Cap 1 retry (anti-boucle). Si "false",
# comportement historique : échec immédiat, feedback au Coder.
# Opt-out utile en environnement verrouillé (CI sans réseau, sandbox stricte).
AUTO_INSTALL_DEPS=true

# --- Anti-Loop Cryptographique (Priorité 3 : circuit-breaker par hash) ---
# Détecte quand le Coder répète EXACTEMENT le même tool call (même outil + mêmes
# arguments, hashés en SHA256) plusieurs fois de suite — le failure mode "tourne
# en rond" qui brûle des tokens sans progresser. Inspiré de Crush. Au-delà du
# seuil, run_with_retry interrompt l'agent avec un message pédagogique au lieu
# de le laisser boucler. Seuil 3 = un humain ne refait jamais 3x le même appel
# identique sans boucler. Opt-out utile pour A/B ou debug.
LOOP_GUARD_ENABLED=true
LOOP_GUARD_THRESHOLD=3

# --- Guard bash denylist (Priorité 8-bis : robustesse runtime) ---
# `bash_command` exécute des commandes issues du LLM via shell=True. Si "true"
# (défaut), un guard denylist bloque les commandes destructrices (rm -rf /,
# format, mkfs, dd vers un disque, shutdown, git push --force, curl|sh...) AVANT
# le subprocess, et renvoie un message pédagogique au LLM. C'est le premier pas
# vers la robustesse runtime (la sandbox Docker complète reste un chantier
# séparé). Si "false", comportement historique (exécution directe sans garde) —
# uniquement pour les environnements de confiance.
BASH_GUARD_ENABLED=true

# --- Nœud PromptRefiner (meta-prompt avant l'Architect) ---
# Si "true" (défaut), un nœud DSPy (gemma REASONING) reformule le prompt utilisateur brut
# en spec structurée AVANT l'Architect — inspiré du pattern "Enhance Prompt" de Kilo Code /
# Cline / Roo Code. Le nœud connaît le catalogue des capacités (skills + statut Context7 +
# testers) pour orienter la spec vers ce qui est faisable. Le prompt raffiné remplace le brut
# pour l'Architect, le Tester et le Judge. Persistance checkpoint (skip LLM à la reprise).
# Si "false", l'Architect reçoit le prompt brut tel quel (comportement historique).
# Opt-out utile si la latence du nœud supplémentaire n'est pas acceptable.
PROMPT_REFINER_ENABLED=true

# Modèle DÉDIÉ pour le PromptRefiner (optionnel, mais fortement recommandé sur GPU contraint).
# Si vide (défaut), le PromptRefiner utilise REASONING_MODEL_ID (gemma-12B) — qui met ~5min/prompt
# (overkill pour de la reformulation). Test comparatif réel (voir log.md) : le gemma-4-E4B
# (5.2 Go) est ~8× plus rapide (27-41s vs 247-318s) pour une qualité de spec équivalente.
# Recommandation : setter sur le E4B (présent sur localhost GPU RTX 3060 6 Go).
# Laisser vide si vous n'avez qu'un seul modèle de raisonnement (= utilise reasoning_model_id).
PROMPT_REFINER_MODEL_ID=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL

# --- Output daté par run (Priorité 13 : isolation des artefacts) ---
# Racine du dossier où chaque run écrit ses fichiers générés. Le workflow coding crée un
# sous-dossier daté `runs/YYYY-MM-DD_HHMM_slug/` et s'y chdir (changement de répertoire de
# travail) avant les nœuds Coder/Tester — au lieu de polluer la racine du projet (constat :
# bubble_sort/ + landing_page/ finissaient à la racine).
# Le chemin du run est persisté dans le checkpoint (DuckDB) pour que la reprise après crash
# reprenne dans le MÊME dossier (fichiers déjà générés préservés). FRESH_START=true → nouveau
# dossier daté. Accepte un chemin relatif (résolu en absolu au runtime) ou absolu.
OUTPUT_DIR=runs
