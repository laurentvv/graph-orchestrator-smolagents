# ============================================================
# Configuration du Graph Orchestrator
# Copiez ce fichier en .env et adaptez les valeurs.
# Toutes les variables sont optionnelles (des défauts s'appliquent).
# ============================================================

## --- Role 1: FAST (Coder, Router) ---
FAST_BACKEND=spawn
# Nom du modèle : gemma-4-E4B-it-qat-GGUF (ou Qwen3.5-9B-Q4_K_M)
FAST_MODEL=D:\LLM_MODELS\blobs\sha256-df0fd4ee07072c607c29a0a1cb4f98918426cca12f45a2776bdd6ee6d09a4de3
FAST_REASONING=off
FAST_MMPROJ=D:\LLM_MODELS\blobs\sha256-7c9bafa27f82d658eda805c1d82ef62bb0368e1ff75f64f77de58ad318beaaf9
FAST_API_BASE=
FAST_API_KEY=
# Leçon run E2E 2026-08-14 : 32768 est trop juste pour le prompt Coder
# (skills + draft + fichiers + retries montent à 33-39k) → 400 exceed_context_size.
# Leçon run 2026-08-19_1552 (F-126) : 49152 dépassé aussi (2 réécritures complètes
# d'un gros fichier → requête 54 115 tokens → run perdu). 65536 donne la marge.
FAST_CONTEXT=65536
# KV quantizé (q8_0) : divise ~2 la VRAM du KV vs f16 → 65536 @q8_0 consomme MOINS
# que 49152 @f16 (RTX 3060 6 Go). Qualité quasi sans perte pour du code
# (cf. docs/LLAMA_SERVER_FLAGS.md §3.2). Vide = f16.
FAST_KV_QUANT=q8_0
# Réutilisation chunks KV (--cache-reuse) : -10% préfill boucle Coder multi-tours
# (bench debug/bench_prefill_flags.py, validé @ctx49152). 256 = preset officiel
# llama.cpp Qwen Coder. 0 = off.
FAST_CACHE_REUSE=256
FAST_TOP_K=20
FAST_MIN_P=0

# --- Role 2: REASONING (Architect) ---
REASONING_BACKEND=spawn
# Nom du modèle : gemma-4-12B-it (reasoning model)
REASONING_MODEL=D:\LLM_MODELS\blobs\sha256-93567e57a8fe10b23569b9d9ec38cd005deedf71e29477c421a4b83f418a538b
REASONING_REASONING=on
REASONING_MMPROJ=D:\LLM_MODELS\blobs\sha256-cb018338a7538a9814d994bfe54644c71eb7ed54e31eae2f721e45fd3c260da7
REASONING_API_BASE=
REASONING_API_KEY=
REASONING_CONTEXT=32768
# Décodage spéculatif MTP (bench debug/test_mtp_spec.py 2026-08-17) : consomme les
# couches nextn des GGUF "-MTP" (ignorées sinon). Gain Ornith-9B @ctx32k : ~+50%
# (draft-mtp + n-max 2 + KV q8_0 : 18,2 → 27,2 tok/s). NE PAS activer sur FAST
# (Qwen-4B : -42%). <PREFIX>_SPEC_MTP=true|false, <PREFIX>_KV_QUANT=q8_0|"" (f16).
REASONING_SPEC_MTP=true
REASONING_KV_QUANT=q8_0
REASONING_TOP_K=20
REASONING_MIN_P=0

# --- Role 3: REASONING_NO_THINK (Judge, Security, Escalation, Web Tester, Consolidation) ---
REASONING_NO_THINK_BACKEND=spawn
# Nom du modèle : gemma-4-12B-it (reasoning model sans thinking)
REASONING_NO_THINK_MODEL=D:\LLM_MODELS\blobs\sha256-93567e57a8fe10b23569b9d9ec38cd005deedf71e29477c421a4b83f418a538b
REASONING_NO_THINK_REASONING=off
# F-168 : cap de generation dedie au spec no-think (Tester pydantic + Coder ULTRA).
# Avant : ces noeuds heritaient de REASONING_MAX_TOKENS (16384) -> reponse
# degeneree jusqu a ~50 min sur le 9B a 5 t/s (run 1835). 4096 ~= 12 min pire cas.
NO_THINK_MAX_TOKENS=4096
REASONING_NO_THINK_MMPROJ=D:\LLM_MODELS\blobs\sha256-cb018338a7538a9814d994bfe54644c71eb7ed54e31eae2f721e45fd3c260da7
REASONING_NO_THINK_API_BASE=
REASONING_NO_THINK_API_KEY=
REASONING_NO_THINK_CONTEXT=32768
REASONING_NO_THINK_SPEC_MTP=true
REASONING_NO_THINK_KV_QUANT=q8_0
# F-155 (bench 2026-08-22, debug/bench_tester_vram.py) : ngl=99 n'est PAS fiable
# sur 6 Go — 9B + mmproj ≈ 6,1 GiB laissent ~180 MiB libres ; selon la frag
# VRAM (Chrome, DWM), les buffers débordent → prefill 83-242 t/s INSTABLE
# (le « hang Chrome du Tester » était ce spill, 100% temps LLM — Chrome : 0,2s).
# Auto-fit (NGL=0) : prefill 576-679 t/s STABLE, gen ~7 t/s (compromis assumé,
# steps Tester dominés par le prefill). Si gen critique : re-bencher ngl=90
# (gen 37 t/s / prefill 249 t/s) MAIS tout ngl>0 reste soumis au seuil VRAM.
REASONING_NO_THINK_NGL=0
REASONING_NO_THINK_TOP_K=20
REASONING_NO_THINK_MIN_P=0

# Température du Coder (CRITIQUE pour le code). Le défaut serveur
# est 1.0 (chat créatif) → corruption aléatoire de la syntaxe. 0.2 = déterministe.
CODER_TEMPERATURE=0.2

# Timeout (secondes) d'un appel LLM. Au-delà, l'appel échoue (et peut être retryé par
# smolagents). Sans timeout, un endpoint distant muet fige le workflow indéfiniment.
# 600s = généreux pour un Coder qui produit un gros fichier en CPU-only distant.
LLM_TIMEOUT_S=600

# --- Règles métier ---
# Seuil de confiance du Juge (un worker avec confidence_score < seuil est rejeté).
JUDGE_CONFIDENCE_THRESHOLD=0.7
# Nombre de tentatives de parsing JSON avant échec définitif.
WORKER_MAX_RETRIES=3

# --- Vérification adversaire (§5 du guide) ---
# Nombre de sceptiques indépendants qui tentent de réfuter chaque résultat.
# Ils tournent en parallèle et partagent le même modèle (économique).
ADVERSARY_COUNT=3
# Fraction de sceptiques requise pour réfuter une tâche (>= 0.5 = majorité).
ADVERSARY_THRESHOLD=0.5

# --- Cycles de convergence (§5, mode exploration) ---
# Hard cap d'itérations : le loop-until-dry s'arrête de force au-delà (anti-boucle-infinie).
MAX_ITERATIONS=3

# --- Human-in-the-loop (§5) ---
# Si true, un prompt bloquant (y/n) demande validation avant la synthèse.
HITL_ENABLED=false
# Nœuds déclenchant le HITL (CSV) — routage stratégique. Seuls ces nœuds
# paused pour approbation humaine (ex: "synth" ou "synth,transaction").
HITL_NODES=synth

# --- Knowledge Graph persistant (Phase 5) ---
# KG_PATH : override du chemin de la base DuckDB du KG.
# Défaut (si non set) : data/graph_orchestrator.db — ancré au paquet via
# config.DEFAULT_KG_PATH, donc indépendant du cwd (stable au chdir du workflow).
# Mettre ":memory:" pour un graphe volatil (perdu en fin de process).
# Sinon, chemin relatif (résolu vs cwd) ou absolu.
# KG_PATH=data/graph_orchestrator.db

# --- Mode de workflow ---
# "one_shot" : Fan-out -> Reduce -> Adversaire -> Synth (défaut, agent_graph.py)
# "exploration" : loop-until-dry sur des tâches d'exploration (python -m graph_orchestrator.workflows)
WORKFLOW_MODE=one_shot

# --- Observabilité / logs ---
# Verbosité des workers en parallèle : LOW (recommandé), MEDIUM, HIGH.
# Le Juge et la Synthèse restent toujours en HIGH (ils sont séquentiels).
LOG_LEVEL=LOW
CONTEXT7_API_KEY=your-api-key-here
# Répertoire des logs de run (auto-capturés, gitignoré). Défaut "logs".
# Chaque exécution d'un workflow y écrit logs/run-<timestamp>-<mode>.log via un Tee
# posé sur stdout+stderr dans workflows.main() (run_logging.py). Fini la redirection
# manuelle (> logs/...log) ; run_analyzer.py y découvre le log le plus récent.
LOGS_DIR=logs
# Active/désactive la capture du log. Opt-out pour A/B ou debug.
LOG_TO_FILE=true

# --- Chrome DevTools MCP (auto-validation visuelle, F-45) ---
# Serveur MCP chrome-devtools-mcp (stdio via npx) : pilote un Chrome live pour que
# le Coder et le WebTester puissent ouvrir la page HTML générée, prendre un screenshot
# (vu par le modèle gemma-4-E4B qui est multimodal) et lire la console JS. Permet de
# détecter une page visuellement ratée AVANT de l'envoyer au Tester.
# CHROME_DEVTOOLS_ENABLED=0 désactive totalement (dégradation gracieuse : les nœuds
#   tournent sans preview, comme avant F-45).
# CHROME_PATH : chemin Chrome optionnel (sinon le serveur détecte l'install système).
#   Sur Windows typiquement : C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_DEVTOOLS_HEADLESS=1 pour CI/sans UI (défaut 0 = navigateur visible pour debug).
CHROME_DEVTOOLS_ENABLED=1
CHROME_PATH=
CHROME_DEVTOOLS_HEADLESS=0
# --- Pool navigateur run-scoped (F-163) ---
# UN seul Chrome par run, spawné par le pool : les serveurs MCP chrome-devtools
# s'y connectent (--browserUrl) au lieu de lancer chacun le leur — plus de
# fuites d'arbres cmd→npx→node→Chrome sous Windows ni de cold-starts ×4/itération.
# Le pool tue l'arbre (taskkill /T /F) au shutdown + balaie les Chrome automation
# résiduels (puppeteer). BROWSER_POOL_ENABLED=0 → comportement historique exact.
BROWSER_POOL_ENABLED=1
# Borne l'attente de démarrage de Chrome (health HTTP /json/version), en secondes.
BROWSER_POOL_SPAWN_TIMEOUT_S=30
# F-90 : DevTools Coder DÉSACTIVÉ par défaut (Coder générateur pur). Chaque
# screenshot DevTools ajoute ~20k tokens au contexte → explosion en ~12 steps +
# biais de confirmation (canvas vide excusé). Validation visuelle déléguée au
# Tester (modèle 9B + critères F-90). Opt-in CODER_DEVTOOLS_ENABLED=1 pour restaurer.
CODER_DEVTOOLS_ENABLED=0

# --- Orchestration des audits (GPU-local vs multi-core) ---
# Tester et Security Reviewer utilisent tous deux le reasoning_model (gemma-12B). Sur un
# GPU local limité, les lancer en parallèle (asyncio.gather) sature la VRAM → le Security
# devient silencieux (jamais de verdict) et le Tester ralentit. AUDIT_PARALLEL=false
# (défaut) les séquentialise : Tester PUIS Security. Mettre true sur une grosse machine
# pour restaurer le parallélisme historique.
AUDIT_PARALLEL=false

# --- Static Tester déterministe (F-49) ---
# Gatekeeper WEB 0-LLM (<6s) inséré entre le Linter et le Tester LLM. Implémente
# la méthodologie prouvée debug/MANUAL_TESTER_METHODOLOGY.md :
#   Tier 1 (<1s) : node --check sur le JS inline (attrape TS-in-vanilla = page
#                 blanche) + wiring addEventListener (attrape slider non branché).
#   Tier 2 (~5s) : visibilité DOM via Chrome DevTools (attrape barres invisibles
#                 = bug CSS height:% que le LLM a raté par biais de confirmation).
# Court-circuite le Tester LLM (25 min) sur les bugs évidents. Web-only (les
# autres technos passent en success direct). Dégradation gracieuse : si `node`
# ou Chrome absent, les étages concernés sont skippés silencieusement.
# STATIC_TESTER_ENABLED=0 désactive le nœud entièrement (pass-through).
# STATIC_TESTER_DEVTOOLS=0 désactive le Tier 2 (Tier 1 seul, plus rapide, 0 Chrome).
# Tier HTTP (F-100, port hermes-agent verify/) : « la page est servie et répond » —
# recette détectée au niveau du dossier (static-web http.server par défaut, ou
# commande start du projet), start sur port libre + sonde readiness + teardown.
# STATIC_TESTER_HTTP=0 le coupe ; STATIC_TESTER_HTTP_TIMEOUT (secondes, défaut 10)
# borne la boucle de readiness.
STATIC_TESTER_ENABLED=1
STATIC_TESTER_DEVTOOLS=1
STATIC_TESTER_HTTP=1
STATIC_TESTER_HTTP_TIMEOUT=10

# --- Reprise après crash (Priorité 3 : Checkpoints) ---
# Si "1"/"true", ignore tout checkpoint existant et démarre une exécution fraîche
# (même si le contenu de la tâche correspond à un run interrompu). Utile pour
# relancer une génération de zéro après avoir modifié le prompt dans tasks.json.
FRESH_START=false

# --- Boucle d'auto-correction (Priorité 2 : capture/troncature stderr) ---
# Sans plafond, un gros traceback (500+ lignes) avalé à chaque itération fait
# exploser le contexte du LLM ("Context Overflow") → la boucle diverge.
# Le Tester polyvalent capture stdout/stderr (web: console JS, python: pytest)
# et tronque (head+tail) avant de l'injecter au Coder. Voir feedback_utils.py.

# Timeout (s) d'un runner de tests en subprocess (pytest, etc.). Au-delà,
# le runner abandonne proprement (un test qui boucle ne fige pas l'usine).
TEST_TIMEOUT_S=120
# Lignes de tête (l'erreur, en haut) et de queue (la cause racine, en bas)
# conservées lors de la troncature. Le milieu bruyant est remplacé par un marqueur.
STDERR_HEAD_LINES=20
STDERR_TAIL_LINES=20
# Plafond global (caractères) du feedback injecté au Coder. L'historique cumulé
# des réfutations (bugs) est borné à cette taille ; les bugs récents sont prioritaires.
FEEDBACK_MAX_CHARS=2000

# --- Nœud d'Escalade (Priorité 3 : post-mortem sur circuit breaker) ---
# Si "true" (défaut), quand une sous-tâche épuise le Circuit Breaker (3 itérations
# toutes rejetées), un nœud DSPy synthétise les réfutations accumulées en un
# diagnostic post-mortem (cause racine + leçon), le persiste dans le Knowledge
# Graph (kind="escalation") et marque la sous-tâche "escalated". Si "false", on
# retombe sur le comportement historique (statut brut "max_iterations_reached").
ESCALATION_ENABLED=true

# --- Auto-Résolution des Dépendances (Priorité 5 : Tester Python) ---
# Si "true" (défaut), quand le PythonTestRunner détecte un `ModuleNotFoundError`
# dans le stderr, il installe lui-même le package manquant (`pip install`,
# non-persistant — n'écrit PAS dans pyproject.toml/uv.lock) puis relance les tests,
# au lieu de gaspiller un cycle LLM pour ça. Cap 1 retry (anti-boucle). Si "false",
# comportement historique : échec immédiat, feedback au Coder.
# Opt-out utile en environnement verrouillé (CI sans réseau, sandbox stricte).
AUTO_INSTALL_DEPS=true

# --- Cap steps du Web Tester (fix TIMINGS_ANALYSE) ---
# Plafond de max_steps pour le Web Tester (Puppeteer). Le défaut historique (24)
# laissait le modèle boucler jusqu'à 10 steps sur une friction JS (ex: querySelector
# écrasé par assignation) sans final_answer (~30 min perdues). 12 = smoke-test +
# 2-4 assertions fonctionnelles, suffisant dans la grande majorité des cas. Remonter
# si une page riche demande plus d'assertions (le Judge attend toutes les assertions
# clés, pas besoin de tout tester).
TESTER_MAX_STEPS=16
# Inline des resources de skill pour le Tester (F-97 / MA-5). Résout la progressive
# disclosure F-92 côté serveur : inline les resources/*.md dans le bloc injecté pour
# éviter que le Tester n'épuise ses steps à les lire une à une (diagnostiqué : 5 steps
# perdus sur 8). false = revenir au comportement F-92 (lecture lazy par l'agent).
TESTER_INLINE_SKILL_RESOURCES=true
# Hard deadline wall-clock du Web Tester (fix blocage Chrome DevTools/Puppeteer).
# Sans ce timeout, un appel MCP bloquant (Chrome hung, npx stdio deadlock, page JS en
# boucle infinie) fige le Tester indéfiniment. À l'expiration, le Tester rend un échec
# propre et le Judge enchaîne. 0 = désactivé (legacy, non recommandé). Si non setté,
# fallback sur TEST_TIMEOUT_S. 480s = FILET (max_steps=8 × ~55s = 440s pire cas doit
# gagner la course pour que le Tester converge au lieu de timeout).
TESTER_TIMEOUT_S=900

# --- Cap steps du Coder (post-mortem run coding_d72dc8e36445c4b6, F-61) ---
# max_steps du CodeAgent Coder. Défaut historique 25 (hardcoded) → boucles jusqu'à
# 87 steps observées (80 min, 18M tokens, crash serveur llama.cpp). Le Coder produit
# en 6-14 steps nominal (baseline Bubble Sort one-shot). 18 bornait la divergence sans
# brider les cas nominaux. 24→30 (2026-08-21, run #8) : à 24, build + rituel
# visual_check + final_answer ne tiennent plus (boucle max-steps → checklist
# rejetée → retry) ; le golden #11 clôturait au step 29-30.
CODER_MAX_STEPS=60
# F-171 : vérificateurs déterministes du Coder (0 LLM) — statique post-écriture + smoke navigateur au verdict
CODER_STATIC_VERIFY=true
CODER_SMOKE_VERDICT=true
# Moteur du nœud Coder (F-158, migration pydantic-ai-harness phase 3) :
#   smolagents (défaut, historique) | pydantic (coder_pydantic.py — FileSystem +
#   output_type=CoderOutput + skills, tool-calls natifs, spike F-157 : -66 % tokens IN).
# Moteur du runner WEB du nœud Tester (F-162, migration pydantic-ai-harness
# phase 3.7) : smolagents (défaut, historique) | pydantic (tester_pydantic.py —
# même socle que le Coder pydantic : gardes/compaction/vision F-159→F-161, MCP
# DevTools + Puppeteer, modèle no_think 9B, prompt F-152 en instructions).
# CODER_PYDANTIC_GUARDS/CODER_PYDANTIC_VISION s'appliquent aussi au Tester
# pydantic (mécanismes partagés du socle).
# Gardes + compaction du Coder pydantic (F-159, phases 3.3-3.4) : LoopGuard v2,
# StallDetector, IdleBreaker, GoalGate, ReviveRetry, SystemReminders (nudges),
# TieredCompaction/DeduplicateFileReads/WarnNearLimits. false = comportement
# exact F-158 (A/B 3.1-3.2). Ne s'applique qu'au moteur pydantic.
# CODER_PYDANTIC_GUARDS=true
# CODER_PYDANTIC_GUARDS=true
# Vision multimodale du Coder pydantic (F-161, phase 3.6) : take_screenshot
# retourne l'image DANS le contexte (ToolReturnPart mixte -> message user
# data-URI -> mmproj llama-server) ; purge perte-zero des anciennes images via
# ProcessHistory (keep = nombre d'images vivantes, 1 = parite F-101/F-116 ;
# archives .transcripts/images/). false = monde sans vision (texte seul).
# CODER_PYDANTIC_VISION=true
# CODER_PYDANTIC_VISION_KEEP=1
# Circuit-breaker sur tours idle consécutifs du Coder (post-mortem idem). _detect_idle_step
# (F-33) réinjecte un message à chaque tour "sans appel d'outil" mais ne coupait JAMAIS
# → boucle possible jusqu'à épuisement des steps (l'anti-loop crypto F-36 ne déclenche
# pas sur un tour sans tool call). Ce seuil borne les idles consécutifs tolérés avant
# échec définitif propre. 3 = tolère 2 ratées (réflexion légitime) puis coupe à la 3e.
IDLE_BREAKER_THRESHOLD=3

# --- Anti-Loop Cryptographique (Priorité 3 : circuit-breaker par hash) ---
# Détecte quand le Coder répète EXACTEMENT le même tool call (même outil + mêmes
# arguments, hashés en SHA256) plusieurs fois de suite — le failure mode "tourne
# en rond" qui brûle des tokens sans progresser. Inspiré de Crush. Au-delà du
# seuil, run_with_retry interrompt l'agent avec un message pédagogique au lieu
# de le laisser boucler. Seuil 3 = un humain ne refait jamais 3x le même appel
# identique sans boucler. Opt-out utile pour A/B ou debug.
LOOP_GUARD_ENABLED=true
LOOP_GUARD_THRESHOLD=3

# --- Stall Detector (Priorité 3-bis / F-88) ---
# Complément de l'Anti-Loop F-36 : détecte (a) un même CONTENU réécrit (hash
# d'output identique — le cas que F-36 rate car il ne hashe que l'input) et
# (b) une série de turns sans livrable matériel nouveau (PROGRESS/IDLE).
# Inspiré de loopx (fiche 19). Si "true" (défaut), au-delà du seuil de turns
# consécutifs "sans changement matériel", run_with_retry interrompt l'agent
# avec un message pédagogique au lieu de le laisser spinner. Seuil 2 = loopx
# MONITOR_DEBT_UNCHANGED_TURN_THRESHOLD (1 tour gratuit est légitime =
# réflexion/relecture, 2 = stall avéré). Si "false", désactivé (A/B/debug).
STALL_DETECTOR_ENABLED=true
STALL_DETECTOR_THRESHOLD=2

# --- Goal Enforcement (Priorité 3-ter / F-99) ---
# Garde comportementale du faux « j'ai fini » (qm goal.ts, fiche 14) : un
# final_answer VALIDE est audité contre l'état autoritaire (écritures +
# livrables sur disque + verify-after web). Non prouvé → prompt de continuation
# (« treat completion as unproven »). Si "false", désactivé (A/B/debug).
# GOAL_BLOCKED_MIN_ROUNDS : la MÊME impasse doit être réclamée N rounds de
# suite avant d'accepter le statut blocked (qm GOAL_BLOCKED_MIN_ROUNDS=3,
# calibré sur WORKER_MAX_RETRIES=3).
# GOAL_WAIVER_STALLED_ROUNDS : N rounds de continuation sans AUCUN tool call
# → auto-waiver anti-deadlock (qm : 5).
# GOAL_TOKEN_CAP : plafond de tokens cumulés (in+out) du nœud → wind-down
# unique, jamais fausse complétion (0 = désactivé).
GOAL_ENFORCEMENT_ENABLED=true
GOAL_BLOCKED_MIN_ROUNDS=3
GOAL_WAIVER_STALLED_ROUNDS=5
GOAL_TOKEN_CAP=2000000

# --- Judge Grounding (Priorité 6 / F-93) ---
# Anti-hallucination de localisation : après le verdict LLM, chaque finding est
# ancré dans le code source (alignement flou de tokens, port simplifié du
# WordAligner de langextract, fiche 39). Les findings non ancrés (ligne inexistante
# ou fragment inventé) sont rétrogradés d'un cran de sévérité + flagués
# "[ungrounded]" ; is_approved est INVARIANT (politique non-destructive : on
# calibre d'abord, le taux de faux positifs sera mesuré par le Meta-Analyste P15
# avant toute automation du verdict). Si "false", désactivé (A/B/debug).
JUDGE_GROUNDING_ENABLED=true

# Judge fail-closed TEST (post-mortem run #3 / F-99-bis) : un verdict de test
# FAILURE/timeout/absent bloque l'approbation SANS appel LLM Judge (le 9B avait
# approuvé une app à animation instantanée + compteur mort malgré le failure du
# Tester). Si "false", le LLM Judge retrouve la main sur les échecs de test.
JUDGE_RESPECT_TEST_FAILURE=true

# Visual Audit matérialisé (F-109, post-mortem run #5) : le Coder DOIT appeler
# visual_check(criterion_number, verdict, observation) pour CHAQUE critère visuel
# après son screenshot — final_answer est bloqué si la checklist est incomplète,
# contient un False ou des observations creuses. Si "false", désactivé (A/B/debug).
VISUAL_AUDIT_ENABLED=true

# Cap fullPage des screenshots (F-114, post-mortem run #9) : le wrapper vision
# force fullPage=False (clés déjà présentes uniquement) — les images fullPage de
# plusieurs milliers de px de haut provoquaient des timeouts LLM (600 s).
# Si "false", le comportement du modèle est respecté.
VISION_FULLPAGE_CAP=true

# Coder Ultra (F-111, resserré F-122) : SEULEMENT à l'itération 3 (dernière
# chance avant escalade) le Coder passe sur le gros modèle no-think
# (REASONING_NO_THINK_* = Ornith-9B) — au plus UNE activation par run.
# Itérations 1-2 = 4B rapide (le 4B sait corriger sur feedback qualitatif,
# run #11). Si "false", jamais d'Ultra (tout en 4B).
CODER_ULTRA_CORRECTION=true

# Checkpoint git par itération (F-102, port open-swe turn_checkpoint) : snapshot
# du worktree au DÉBUT de chaque itération Coder sans toucher HEAD/index/worktree
# (GIT_INDEX_FILE scratch + update-ref refs/graph-orchestrator/turns/<key>).
# Le Judge reçoit un résumé structuré « ce que git dit » (statut +ajouts/-
# suppressions par fichier), complément du diff texte F-53, disponible dès
# l'itération 1. Si "false", retour au comportement F-53 seul.
TURN_CHECKPOINT_ENABLED=true

# --- Matérialisation du plan (F-120, transposition planning-with-files) ---
# Écrit plan.md (miroir fidèle de TOUT l'ArchitectOutput : architecture globale,
# sous-tâches, stratégie/sections, checklist fichiers, critères visuels/
# fonctionnels/rubric F-82, skills) + task.md (checklist vivante + journal des
# verdicts) dans le dossier du run, régénérés à chaque transition par
# workflows.py (déterministe, best-effort, jamais bloquant). Un anchor court
# stable est aussi injecté dans le prompt Coder à chaque itération (levier de
# convergence 4B des post-mortems #10/#11). Si "false" : aucun fichier ni anchor.
PLAN_TASK_MATERIALIZE=true

# --- Retry transport LLM v2 (Priorité 8 / F-104) ---
# Retry PRÉ-CONTENU au niveau de l'appel LLM (openfox) : un « Connection error »
# transitoire est rejoué à l'identique, transparent pour l'agent (rien n'entre
# dans l'historique — vs run_with_retry qui purge la mémoire du nœud). Backoff
# exponentiel + jitter 25% + cap 30s + retry-after prioritaire (opencode).
# LLM_TRANSPORT_RETRIES=5 sert aussi de num_retries litellm (nœuds DSPy).
# Serveur spawné mort mid-run (crash VRAM) → respawn entre 2 tentatives.
LLM_RETRY_ENABLED=true
LLM_TRANSPORT_RETRIES=5
LLM_RETRY_BASE_DELAY_S=1.0
LLM_RETRY_MAX_DELAY_S=30.0
LLM_RETRY_JITTER=0.25

# --- Compaction v2 (Priorité 9 / F-101) ---
# Archive disque perte-zéro : steps snippés -> .transcripts/*.jsonl, gros tool
# outputs -> .task_outputs/tool-results/ (dossier du run). Garde overflow pi :
# UNE SEULE récupération de contexte débordé par nœud, sinon échec propre.
COMPACTION_ARCHIVE_ENABLED=true
COMPACTION_OVERFLOW_GUARD=true

# --- Compaction v3 résiliente (F-116, kilocode chunks/payload-recovery) ---
# Clip du model_output des steps anciens (fichiers entiers passés à write_file
# = le trou n°1 du thrash 990k tokens/step des runs #13/#16 ; version intégrale
# persistée dans .transcripts/). Preflight : estimation AVANT envoi, escalade
# déterministe si condamnée. Boundary de retry : soft = compaction hiérarchique
# (archive + trace + culs-de-sac + queue), hard = purge totale historique.
COMPACTION_CLIP_ENABLED=true
COMPACTION_PREFLIGHT_ENABLED=true
COMPACTION_PREFLIGHT_BUDGET_TOKENS=26000
COMPACTION_RETRY_MODE=soft
# Volet LLM sémantique opt-in (ex-F-86) : résumé d'historique dans la
# récupération overflow, gardé par CompactionBudget (remboursement sur usage
# réel). DÉSACTIVÉ par défaut — la compaction 0-LLM reste la défaut.
COMPACTION_LLM_ENABLED=false
COMPACTION_LLM_MAX_TOKENS=1024

# --- Init MCP non bloquante (Priorité 8 / F-104, crush) ---
# Timeout de connexion PAR SERVEUR (un npx pendu ne bloque jamais le run).
# Timeout → dégradation gracieuse (le nœud tourne sans ces outils).
CHROME_DEVTOOLS_CONNECT_TIMEOUT_S=25
CONTEXT7_CONNECT_TIMEOUT_S=15
PUPPETEER_CONNECT_TIMEOUT_S=25

# --- Consolidation mémoire KG (Priorité 6-ter / F-68 Phase 1) ---
# Le KG DuckDB grossit indéfiniment (dedup_key ne capte que les doublons exacts).
# MEMORY_CONSOLIDATION_ENABLED=true (défaut) : à la fin d'un run, un LLM-juge
# émet des actions UPDATE/DELETE/ADD pour dédupliquer/fusionner les claims
# rabâchés (format qm consolidation.ts). MEMORY_CONSOLIDATION_AFTER=10 : seuil
# minimal de claims par entité pour déclencher l'appel LLM (en dessous, skip).
# MEMORY_RETENTION_DAYS=30 : oubli par rétention temporelle — prune des claims
# plus anciens, en préservant escalation+insight (leçons durables cross-run).
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_AFTER=10
MEMORY_RETENTION_DAYS=30

# --- Mémoire cross-run recall (Priorité 6-ter / F-68 Phase 2) ---
# MEMORY_RECALL_ENABLED=true (défaut) : en DÉBUT de run, on rappelle les N leçons
# durables (insight+escalation) les plus récentes de TOUS les runs passés et on
# les injecte dans le prompt Coder (ferme la boucle d'apprentissage). Déterministe
# (0 LLM, 1 query SQL). MEMORY_RECALL_LIMIT=8 : top-N leçons par récence.
# MEMORY_RECALL_MAX_CHARS=1500 : budget caractères du bloc injecté au Coder.
MEMORY_RECALL_ENABLED=true
MEMORY_RECALL_LIMIT=8
MEMORY_RECALL_MAX_CHARS=1500

# --- Sanitizer (Auto-typage des arguments d'outil, Priorité 8 / F-42) ---
# Si "true" (défaut), les arguments d'outil malformés émis par le petit LLM
# (ex: offset="1, 80" → 80, replace_all="true" → True) sont coerce best-effort
# vers le type déclaré dans le schéma tool.inputs AVANT l'appel d'outil → moins
# de retries gaspillées sur les erreurs de validation de type. Déterministe, 0
# LLM. Valeur non coercible laissée telle quelle (la validation smolagents reste
# l'arbitre final). Si "false", les arguments passent inchangés (comportement
# historique) — utile pour A/B ou debug.
SANITIZER_ENABLED=true


# --- Skills : sélection par l'Architect + budget tokens (Priorité 10, F-57) ---
# L'Architect sélectionne les skills pertinents dans son plan (ex: frontend-design
# pour le web). Le Coder reçoit leur corps complet directement. Ce budget (en tokens)
# plafonne la sélection pour éviter la saturation du contexte (32k sur Qwen 9B).
# Défaut 8000 tokens (~24%). Le socle file-creation+coding+context7-research (~3000 tok)
# est toujours injecté ; les skills conditionnels sont rognés si dépassement.
SKILL_BUDGET_TOKENS=8000

# --- Skill Finder (F-82) : recherche/install auto de skills depuis skills.sh ---
# Si "true" (défaut), l'Architect lance une étape ReAct qui interroge skills.sh
# (CLI `npx skills`) pour combler une lacune de compétence : trouve un skill,
# vérifie l'auteur (allowlist ci-dessous) + les signaux skills.sh (safe/verified),
# l'installe dans skills/, puis enregistre une ligne regex dédiée (mots-clés
# extraits de la description du skill) pour que le Coder le reconnaisse comme les
# autres skills. Le skill installé entre dans le pipeline lazy F-57 (catalogue
# metadata + budget tokens + load_skill si trop gros). Fail-open (jamais ne crash
# le run). Si "false", l'étape ReAct est skipée (pas de coût LLM/npx/réseau).
SKILL_FINDER_ENABLED=true
# Allowlist d'auteurs de confiance (CSV) — hard gate du téléchargement (spec
# « n'autoriser que les auteurs de confiance »). Un marqueur négatif skills.sh
# (unsafe/malicious/deprecated) bloque même un auteur de confiance.
SKILL_FINDER_TRUSTED_AUTHORS=vercel-labs,anthropics,openai,github,microsoft,google-labs-code,clerk,greensock,gamedev-skills,elevenlabs,omer-metin

# --- Guard bash denylist (Priorité 8-bis : robustesse runtime) ---
# `bash_command` exécute des commandes issues du LLM via shell=True. Si "true"
# (défaut), un guard denylist bloque les commandes destructrices (rm -rf /,
# format, mkfs, dd vers un disque, shutdown, git push --force, curl|sh...) AVANT
# le subprocess, et renvoie un message pédagogique au LLM. C'est le premier pas
# vers la robustesse runtime (la sandbox Docker complète reste un chantier
# séparé). Si "false", comportement historique (exécution directe sans garde) —
# uniquement pour les environnements de confiance.
BASH_GUARD_ENABLED=true

# --- Redaction de secrets (F-105, Priorité 8-bis) ---
# Si "true" (défaut), les secrets reconnaissables (API keys sk-/ghp_/AKIA/xox,
# JWT, en-têtes Bearer, passwords littéraux, clés privées PEM, identifiants
# d'URL) sont remplaces par <REDACTED> dans le feedback injecte au LLM
# (branchement : feedback_utils.truncate_output). Fail-open documente : du code
# n'est jamais corrompu ; DuckDB conserve le contenu integral (audit). Opt-out
# pour diagnostiquer un feedback "masque".
REDACTION_ENABLED=true

# --- Nœud PromptRefiner (meta-prompt avant l'Architect) ---
# Si "true" (défaut), un nœud DSPy reformule le prompt utilisateur brut en spec structurée
# AVANT l'Architect — inspiré du pattern "Enhance Prompt" de Kilo Code / Cline / Roo Code.
# Le nœud connaît le catalogue des capacités (skills + statut Context7 + testers) pour
# orienter la spec vers ce qui est faisable. Le prompt raffiné remplace le brut pour
# l'Architect, le Tester et le Judge. Persistance checkpoint (skip LLM à la reprise).
# Si "false", l'Architect reçoit le prompt brut tel quel (comportement historique).
# Opt-out utile si la latence du nœud supplémentaire n'est pas acceptable.
#
# Modèle utilisé : FAST_MODEL (Qwen3.5-4B, comme le Coder). C'est une tâche de reformulation
# légère, pas de raisonnement profond — pas besoin d'un 9B. Migration 2026-08-10
# (fix/prompt-refiner-fast-spec) : avant ce nœud tournait sur reasoning_spec + override
# gemma-4-E4B (PROMPT_REFINER_MODEL_ID), ce qui spawnait un serveur lourd supplémentaire.
PROMPT_REFINER_ENABLED=true

# PROMPT_REFINER_MODEL_ID : DORMANT depuis la migration 2026-08-10. PromptRefiner utilise
# désormais FAST_MODEL directement. Variable conservée pour rétro-compat .env, mais ignorée
# du code. À nettoyer dans un cycle de doc futur.
PROMPT_REFINER_MODEL_ID=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL

# --- Idempotence des effets de bord (Priorité 8-bis : robustesse runtime) ---
# Garantit que les effets de bord non-idempotents (append_file, pip install) ne
# sont appliqués qu'UNE FOIS par run_id — même après un replay de checkpoint
# (reprise après crash). Sans cela, un append ré-appliqué au replay duplique une
# section, et un pip install ré-appliqué gaspille du réseau. Inspiré de qm
# (idempotency-store.ts : once(key, fn) avec backing durable + rétention 14j).
# Backing = même DB DuckDB que le KG (table idempotency_record). Cycle de vie lié
# au checkpoint (clear aux mêmes sites que clear_checkpoint). Si "false", aucun
# store n'est créé → comportement historique (re-applique les effets au replay) —
# utile pour A/B ou debug.
IDEMPOTENCE_ENABLED=true
# Rétention des records d'idempotence en jours (défaut 14, aligné sur qm). Au-delà,
# les records expirés sont supprimés par un pruning lazy (pas à chaque appel).
IDEMPOTENCE_RETENTION_DAYS=14

# --- Output daté par run (Priorité 13 : isolation des artefacts) ---
# Racine du dossier où chaque run écrit ses fichiers générés. Le workflow coding crée un
# sous-dossier daté `runs/YYYY-MM-DD_HHMM_slug/` et s'y chdir (changement de répertoire de
# travail) avant les nœuds Coder/Tester — au lieu de polluer la racine du projet (constat :
# bubble_sort/ + landing_page/ finissaient à la racine).
# Le chemin du run est persisté dans le checkpoint (DuckDB) pour que la reprise après crash
# reprenne dans le MÊME dossier (fichiers déjà générés préservés). FRESH_START=true → nouveau
# dossier daté. Accepte un chemin relatif (résolu en absolu au runtime) ou absolu.
OUTPUT_DIR=runs
# Nombre de runs à conserver pour éviter que le dossier ne grossisse indéfiniment.
# 0 = désactivé (conservation infinie).
#OUTPUT_RETENTION=10

# --- Robustesse FS : verrous + transactions + cloisonnement IO (Priorité 8-bis / F-95) ---
# Port OpenKB (fiche 32). Trois couches complémentaires, chacune opt-out :
# RUN_DIR_LOCK : verrou exclusif CROSS-PROCESS sur le dossier du run (<run>/.fs_tx/dir.lock)
# — deux process ne peuvent pas muter le même run (ex: deux reprises du même checkpoint).
# La 1re acquisition exclusive DRAINE les journaux de transaction actifs (crash-recovery).
# FS_TRANSACTIONS : snapshot+journal autour de chaque appel Coder — un process mort
# mi-écriture laisse un journal "active" roulé back au prochain run (annule les effets
# partiellement appliqués ; complète l'idempotence F-43).
# IO_ALLOWLIST : outils FS du Coder confinés au dossier du run (le Coder ne peut plus
# écrire dans l'usine hôte). Fail-open hors run (aucune racine enregistrée = tout passe).
RUN_DIR_LOCK_ENABLED=true
FS_TRANSACTIONS_ENABLED=true
IO_ALLOWLIST_ENABLED=true

# Prefill code-block (2026-08-22) : llama-server continue le message assistant
# incomplet "```python" → la réponse démarre DANS un bloc code. Default off.
# Sampler DRY : anti-répétition séquences. 0 = désactivé (défaut).
FAST_DRY_MULTIPLIER=0.0
FAST_DRY_ALLOWED_LENGTH=0
FAST_DRY_PENALTY_LAST_N=0
