# ============================================================
# Configuration du Graph Orchestrator
# Copiez ce fichier en .env et adaptez les valeurs.
# Toutes les variables sont optionnelles (des défauts s'appliquent).
# ============================================================

# --- Connexion Ollama (endpoint OpenAI-compatible) ---
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=sk-local

# --- Tiering des modèles ---
# Fan-out (workers) : modèle léger avec tool-calling natif.
FAST_MODEL_ID=qwen3.5:2b
# Juge + Synthèse : modèle de raisonnement costaud.
REASONING_MODEL_ID=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# IMPORTANT : max_tokens généreux obligatoire pour Gemma. Sans ça, Ollama
# renvoie finish_reason=length sans tool_calls (le raisonnement interne consomme tout).
REASONING_MAX_TOKENS=8192
# Budget de génération du modèle FAST (Coder). Un fichier HTML/CSS/JS complet
# dépasse 2000-4000 tokens ; trop bas = génération coupée en plein tool_call JSON
# = contenu corrompu. 12000 laisse de la marge (inclut le "thinking" du Qwen3.5).
FAST_MAX_TOKENS=12000
# Température du Coder (CRITIQUE pour le code). Le défaut serveur qwen3.5:4b est
# 1.0 (chat créatif) → corruption aléatoire de la syntaxe. 0.2 = déterministe.
CODER_TEMPERATURE=0.2

# --- Règles métier ---
# Seuil de confiance du Juge (un worker avec confidence_score < seuil est rejeté).
JUDGE_CONFIDENCE_THRESHOLD=0.7
# Nombre de tentatives de parsing JSON avant échec définitif.
WORKER_MAX_RETRIES=3

# --- Vérification adversaire (§5 du guide) ---
# Nombre de sceptiques indépendants qui tentent de réfuter chaque résultat.
# Ils tournent en parallèle et partagent le même modèle (économique).
ADVERSARY_COUNT=3
# Fraction de sceptiques requise pour réfuter une tâche (>= 0.5 = majorité).
ADVERSARY_THRESHOLD=0.5

# --- Cycles de convergence (§5, mode exploration) ---
# Hard cap d'itérations : le loop-until-dry s'arrête de force au-delà (anti-boucle-infinie).
MAX_ITERATIONS=3

# --- Human-in-the-loop (§5) ---
# Si true, un prompt bloquant (y/n) demande validation avant la synthèse.
HITL_ENABLED=false
# Nœuds déclenchant le HITL (CSV) — routage stratégique. Seuls ces nœuds
# paused pour approbation humaine (ex: "synth" ou "synth,transaction").
HITL_NODES=synth

# --- Knowledge Graph persistant (Phase 5) ---
# Chemin du fichier DuckDB. ":memory:" = graphe volatil (perdu à la fin du process).
KG_PATH=graph_orchestrator.db

# --- Mode de workflow ---
# "one_shot" : Fan-out -> Reduce -> Adversaire -> Synth (défaut, agent_graph.py)
# "exploration" : loop-until-dry sur des tâches d'exploration (python -m graph_orchestrator.workflows)
WORKFLOW_MODE=one_shot

# --- Observabilité / logs ---
# Verbosité des workers en parallèle : LOW (recommandé), MEDIUM, HIGH.
# Le Juge et la Synthèse restent toujours en HIGH (ils sont séquentiels).
LOG_LEVEL=LOW
CONTEXT7_API_KEY=your-api-key-here

# --- Reprise après crash (Priorité 3 : Checkpoints) ---
# Si "1"/"true", ignore tout checkpoint existant et démarre une exécution fraîche
# (même si le contenu de la tâche correspond à un run interrompu). Utile pour
# relancer une génération de zéro après avoir modifié le prompt dans tasks.json.
FRESH_START=false
